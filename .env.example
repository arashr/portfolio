# PostHog (EU) — optional local overrides for analytics
# Copy to .env and fill in. Never commit .env.
#
# Project tokens (phc_…) are write-only and safe in the browser once you enable
# analytics — still prefer injecting via env/local so Git history stays clean.
# NEVER put a personal API key (phx_…) or any private PostHog credential here.

POSTHOG_PROJECT_TOKEN=
POSTHOG_ENABLED=true
