{
  "_comment": "Recovery copy of landing.header. Paste into gallery.config.json if settings get lost.",
  "landing": {
    "header": {
      "ground": "indigo",
      "titleFace": "bricolage-grotesque",
      "titleScale": {
        "minPx": 160,
        "maxPx": 240,
        "maxWidthRatio": 0.92,
        "maxLines": 2,
        "maxPxRatio": 0.85
      },
      "layout": {
        "titleColumnSpan": 12,
        "copyColumnSpan": 12,
        "minHeight": "66vh"
      },
      "glyph": {
        "color": "red",
        "symbolPool": "/",
        "symbolProbability": 1,
        "patternTypes": ["fill"],
        "opacityMin": 1,
        "opacityMax": 1,
        "blendModes": {
          "screen": { "min": 1, "max": 1 }
        },
        "shape": {
          "fillSpace": false,
          "opticalTight": false,
          "followPath": true,
          "flipReadable": true,
          "flipAlternateVertical": true,
          "flipAlternateHorizontal": true
        },
        "geometry": {
          "repeatsMin": 90,
          "repeatsMax": 190,
          "fontSizeMin": 200,
          "fontSizeMax": 300,
          "paddingMin": 0,
          "paddingMax": 0,
          "tightTrackingMin": 0.92,
          "tightTrackingMax": 0.98,
          "gridColumnsMin": 2,
          "gridColumnsMax": 12,
          "gridStaggerProbability": 1,
          "fillAngleMin": -25,
          "fillAngleMax": 7,
          "fillRowGapMin": 1,
          "fillRowGapMax": 10
        },
        "placement": {
          "regionPreference": ["top"],
          "preferEmptySpace": false,
          "alignToCardEdge": true
        }
      }
    }
  }
}
